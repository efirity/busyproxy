# BusyProxy iOS — TestFlight / device Fastlane
#
# On mm_ser (or any Mac with ASC API key):
#   cd ~/dev/busyproxy/ios
#   source ~/.config/appstoreconnect/env
#   export PATH="/opt/homebrew/bin:/opt/homebrew/opt/ruby/bin:/opt/homebrew/lib/ruby/gems/4.0.0/bin:$PATH"
#   export APPLE_TEAM_ID=RA9PQ9434F
#   fastlane register_ids
#   fastlane beta
#
# Prereqs:
#   - App Store Connect API key at ~/.config/appstoreconnect/key.p8
#   - APP_STORE_CONNECT_KEY_ID + APP_STORE_CONNECT_ISSUER_ID
#   - Apple Distribution cert for team RA9PQ9434F (present on mm_ser)

default_platform(:ios)

APP_STORE_CONNECT_API_KEY_PATH = File.expand_path(
  ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH", "~/.config/appstoreconnect/key.p8"),
)
APP_STORE_CONNECT_KEY_ID = ENV.fetch("APP_STORE_CONNECT_KEY_ID", "")
APP_STORE_CONNECT_ISSUER_ID = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID", "")

MAIN_ID = ENV.fetch("IOS_BUNDLE_ID", "net.busyproxy.app.ios")
TUNNEL_ID = ENV.fetch("IOS_TUNNEL_BUNDLE_ID", "net.busyproxy.app.ios.tunnel")
WIDGETS_ID = ENV.fetch("IOS_WIDGETS_BUNDLE_ID", "net.busyproxy.app.ios.widgets")
TEAM_ID = ENV.fetch("APPLE_TEAM_ID", ENV.fetch("FASTLANE_TEAM_ID", "RA9PQ9434F"))
APP_NAME = "BusyProxy"

platform :ios do
  before_all do |lane, _options|
    env_file = File.expand_path("../secrets/fastlane.env", __dir__)
    if File.exist?(env_file)
      File.readlines(env_file).each do |line|
        line = line.strip
        next if line.empty? || line.start_with?("#")
        k, v = line.split("=", 2)
        next unless k && v
        ENV[k.strip] ||= v.strip.gsub(/\A["']|["']\z/, "")
      end
      UI.message("Loaded ios/secrets/fastlane.env")
    end

    next if %i[build_sim ios_whoami].include?(lane)

    if APP_STORE_CONNECT_KEY_ID.empty? || APP_STORE_CONNECT_ISSUER_ID.empty?
      UI.user_error!(
        "Set APP_STORE_CONNECT_KEY_ID + APP_STORE_CONNECT_ISSUER_ID " \
        "(e.g. source ~/.config/appstoreconnect/env)",
      )
    end
    unless File.exist?(APP_STORE_CONNECT_API_KEY_PATH)
      UI.user_error!("Missing API key at #{APP_STORE_CONNECT_API_KEY_PATH}")
    end
  end

  desc "Show Fastlane + signing + bundle IDs"
  lane :ios_whoami do
    UI.header("BusyProxy iOS")
    UI.message("fastlane: #{Fastlane::VERSION}")
    UI.message("team:     #{TEAM_ID}")
    UI.message("app:      #{MAIN_ID}")
    UI.message("tunnel:   #{TUNNEL_ID}")
    UI.message("key:      #{APP_STORE_CONNECT_API_KEY_PATH}")
    sh("security find-identity -v -p codesigning || true")
    sh("xcodebuild -version")
  end

  desc "Build for iOS Simulator (no signing)"
  lane :build_sim do
    gym(
      project: "BusyProxy.xcodeproj",
      scheme: "BusyProxy",
      configuration: "Debug",
      destination: ENV["IOS_SIM_DEST"] || "generic/platform=iOS Simulator",
      skip_package_ipa: true,
      skip_archive: true,
      derived_data_path: "build/DerivedData",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
    )
  end

  desc "Create App IDs + ASC app record (App Groups + Network Extension)"
  lane :register_ids do
    api_key = asc_api_key

    UI.header("Register Developer App IDs + App Store Connect app")
    # Create main + tunnel App IDs (Developer Portal via Spaceship when possible)
    begin
      produce(
        api_key: api_key,
        app_identifier: MAIN_ID,
        app_name: APP_NAME,
        team_id: TEAM_ID,
        skip_itc: false,
        language: "en-US",
        sku: "busyproxy-ios-#{Time.now.to_i}",
      )
    rescue => e
      UI.important("produce main: #{e.message}")
    end

    begin
      produce(
        api_key: api_key,
        app_identifier: TUNNEL_ID,
        app_name: "#{APP_NAME} Tunnel",
        team_id: TEAM_ID,
        skip_itc: true, # extension is not a separate ASC app
      )
    rescue => e
      UI.important("produce tunnel: #{e.message}")
    end

    # Enable capabilities via Spaceship ConnectAPI BundleId
    sh(
      "ruby",
      File.expand_path("scripts/enable_capabilities.rb", __dir__),
    )
    UI.success("Register step finished — check developer.apple.com if capabilities still missing")
  end

  desc "Archive + upload to TestFlight (internal testers by default)"
  lane :beta do
    api_key = asc_api_key

    # Bump build number (CURRENT_PROJECT_VERSION) if requested
    if ENV["BUMP_BUILD"] == "1"
      increment_build_number(
        xcodeproj: "BusyProxy.xcodeproj",
        build_number: (latest_testflight_build_number(
          api_key: api_key,
          app_identifier: MAIN_ID,
        ).to_i + 1).to_s,
      )
    end

    build_number = get_build_number(xcodeproj: "BusyProxy.xcodeproj")
    version = get_version_number(xcodeproj: "BusyProxy.xcodeproj", target: "BusyProxy")
    UI.message("Building BusyProxy #{version} (#{build_number}) for App Store / TestFlight")

    # Manual App Store profiles (include App Groups + Packet Tunnel).
    # Created via fastlane/scripts/setup_signing.rb + Portal app group associate.
    main_profile = ENV.fetch("IOS_PROFILE_NAME", "BusyProxy AppStore")
    tunnel_profile = ENV.fetch("IOS_TUNNEL_PROFILE_NAME", "BusyProxyTunnel AppStore")
    widgets_profile = ENV.fetch("IOS_WIDGETS_PROFILE_NAME", "BusyProxyWidgets AppStore")

    # Ensure Widget extension App ID + App Store profile exist (Live Activities)
    ensure_widgets_signing!(api_key)

    # Per-target profile for extensions via xcodeproj before archive.
    require "xcodeproj"
    project_path = File.expand_path("../BusyProxy.xcodeproj", __dir__)
    project = Xcodeproj::Project.open(project_path)
    project.targets.each do |t|
      t.build_configurations.each do |cfg|
        next unless cfg.name == "Release"
        cfg.build_settings["CODE_SIGN_STYLE"] = "Manual"
        cfg.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
        cfg.build_settings["CODE_SIGN_IDENTITY[sdk=iphoneos*]"] = "Apple Distribution"
        cfg.build_settings["DEVELOPMENT_TEAM"] = TEAM_ID
        case t.name
        when "BusyProxy"
          cfg.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = main_profile
        when "BusyProxyTunnel"
          cfg.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = tunnel_profile
        when "BusyProxyWidgets"
          cfg.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = widgets_profile
        end
      end
    end
    project.save
    UI.message("Release signing: Manual + #{main_profile} / #{tunnel_profile} / #{widgets_profile}")

    build_app(
      project: "BusyProxy.xcodeproj",
      scheme: "BusyProxy",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/fastlane",
      output_name: "BusyProxy-#{version}-#{build_number}.ipa",
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          MAIN_ID => main_profile,
          TUNNEL_ID => tunnel_profile,
          WIDGETS_ID => widgets_profile,
        },
      },
    )

    changelog = ENV["FL_CHANGELOG"] || "BusyProxy earner iOS — multi-language, reverse tunnel, TestFlight internal build."

    upload_to_testflight(
      api_key: api_key,
      app_identifier: MAIN_ID,
      ipa: "build/fastlane/BusyProxy-#{version}-#{build_number}.ipa",
      skip_waiting_for_build_processing: ENV["SKIP_WAIT"] != "0",
      distribute_external: false,
      notify_external_testers: false,
      changelog: changelog,
      # Internal testing group is automatic for App Store Connect users with access
    )

    UI.success(
      "Uploaded #{version} (#{build_number}) to TestFlight.\n" \
      "Internal testers: App Store Connect → BusyProxy → TestFlight → Internal Testing.\n" \
      "Processing usually takes 5–30 minutes.",
    )
  end

  desc "Upload App Store listing metadata (no binary). Uses ios/fastlane/metadata/"
  lane :store_metadata do
    api_key = asc_api_key
    # deliver errors if both api_key hash and APP_STORE_CONNECT_API_KEY_PATH env are set
    ENV.delete("APP_STORE_CONNECT_API_KEY_PATH")
    ENV.delete("APP_STORE_CONNECT_KEY_PATH")

    upload_to_app_store(
      api_key: api_key,
      app_identifier: MAIN_ID,
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      force: true, # skip HTML preview confirmation
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false,
      # First version cannot set "What's New" until after initial release
      ignore_language_directory_validation: true,
    )
    UI.success("Metadata pushed to App Store Connect (en-US). Screenshots/age rating may still need the ASC UI.")
  end

  desc "Install development build on a connected device (e.g. BMDEV10)"
  lane :deploy_device do
    api_key = asc_api_key
    device_name = ENV["IOS_DEVICE"] || "BMDEV10"
    team = TEAM_ID

    auth_xcargs = [
      "-allowProvisioningUpdates",
      "-allowProvisioningDeviceRegistration",
      "-authenticationKeyPath", APP_STORE_CONNECT_API_KEY_PATH.shellescape,
      "-authenticationKeyID", APP_STORE_CONNECT_KEY_ID.shellescape,
      "-authenticationKeyIssuerID", APP_STORE_CONNECT_ISSUER_ID.shellescape,
      "DEVELOPMENT_TEAM=#{team}",
      "CODE_SIGN_STYLE=Automatic",
    ].join(" ")

    build_app(
      project: "BusyProxy.xcodeproj",
      scheme: "BusyProxy",
      configuration: "Debug",
      export_method: "development",
      destination: "platform=iOS,name=#{device_name}",
      skip_package_ipa: true,
      skip_archive: true,
      derived_data_path: "build/DerivedDataDevice",
      xcargs: auth_xcargs,
    )

    app_path = Dir[
      "build/DerivedDataDevice/Build/Products/Debug-iphoneos/BusyProxy.app",
    ].first
    UI.user_error!("App not found after build") unless app_path && File.directory?(app_path)

    sh(
      "xcrun", "devicectl", "device", "install", "app",
      "--device", "name:#{device_name}",
      app_path,
    )
    UI.success("Installed on #{device_name}")
  end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: APP_STORE_CONNECT_KEY_ID,
    issuer_id: APP_STORE_CONNECT_ISSUER_ID,
    key_filepath: APP_STORE_CONNECT_API_KEY_PATH,
    duration: 1200,
    in_house: false,
  )
end

def ensure_widgets_signing!(_api_key)
  require "spaceship"
  require "base64"
  require "fileutils"

  token = Spaceship::ConnectAPI::Token.create(
    key_id: APP_STORE_CONNECT_KEY_ID,
    issuer_id: APP_STORE_CONNECT_ISSUER_ID,
    filepath: APP_STORE_CONNECT_API_KEY_PATH,
  )
  Spaceship::ConnectAPI.token = token

  bid = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == WIDGETS_ID }
  unless bid
    UI.message("Creating App ID #{WIDGETS_ID}…")
    bid = Spaceship::ConnectAPI::BundleId.create(
      name: "BusyProxy Widgets",
      identifier: WIDGETS_ID,
      platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
    )
  end
  # App Groups for shared identity (optional for Live Activities, good for future)
  begin
    caps = bid.get_capabilities || []
    unless caps.any? { |c| c.capability_type.to_s.include?("APP_GROUP") }
      bid.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)
    end
  rescue => e
    UI.important("widgets App Groups: #{e.message}")
  end

  # Associate group via Portal if session available is optional; profiles still work

  profile_name = "BusyProxyWidgets AppStore"
  existing = Spaceship::ConnectAPI::Profile.all.find { |p| p.name == profile_name }
  dist = Spaceship::ConnectAPI::Certificate.all.find { |c|
    c.certificate_type.to_s == "DISTRIBUTION" && c.id.to_s == "Q3UD398WPL"
  } || Spaceship::ConnectAPI::Certificate.all.find { |c| c.certificate_type.to_s == "DISTRIBUTION" }

  if existing.nil? && dist
    UI.message("Creating profile #{profile_name}…")
    existing = Spaceship::ConnectAPI::Profile.create(
      name: profile_name,
      profile_type: "IOS_APP_STORE",
      bundle_id_id: bid.id,
      certificate_ids: [dist.id],
      device_ids: [],
    )
  end

  if existing
    raw = Base64.decode64(existing.profile_content)
    dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(dir)
    # uuid from profile
    require "tmpdir"
    tmp = File.join(Dir.tmpdir, "bp-widgets.mobileprovision")
    File.binwrite(tmp, raw)
    uuid = `security cms -D -i #{tmp.shellescape} 2>/dev/null`[/UUID<\/key>\s*<string>([^<]+)/, 1]
    path = File.join(dir, "#{uuid || existing.id}.mobileprovision")
    File.binwrite(path, raw)
    UI.message("Installed widgets profile → #{path}")
  end
rescue => e
  UI.important("ensure_widgets_signing!: #{e.class}: #{e.message}")
end
