# BusyProxy iOS — prefers App Store Connect API key auth (no interactive 2FA).
# On mm_ser: source ~/.config/appstoreconnect/env

team_id(ENV["APPLE_TEAM_ID"] || ENV["FASTLANE_TEAM_ID"] || "RA9PQ9434F")
itc_team_id(ENV["ITC_TEAM_ID"]) if ENV["ITC_TEAM_ID"]

for_platform :ios do
  app_identifier(ENV["IOS_BUNDLE_ID"] || "net.busyproxy.app.ios")
end

# Optional Apple ID only if a lane still needs portal cookie auth
apple_id(ENV["FASTLANE_USER"] || ENV["APPLE_ID"]) if ENV["FASTLANE_USER"] || ENV["APPLE_ID"]
