# Copy to .env — never commit .env

# DigitalOcean (optional for local app)
# DO_KEY=dop_v1_...

# Stripe (test ok)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Alias also accepted by server code:
# STRIPE_PUB_KEY=pk_test_...
MIN_WITHDRAW_CENTS=2000
# STRIPE_CURRENCY=
# STRIPE_CONNECT_COUNTRY=SG

# Supabase (self-hosted BusyProxy stack — bp.efir.is)
SUPABASE_URL=https://bp.efir.is
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Studio / MCP (optional for local app; needed for MCP + Studio)
# SUPABASE_DASHBOARD_USERNAME=hi@busyproxy.net
# SUPABASE_DASHBOARD_PASSWORD=
# SUPABASE_MCP_URL=https://bp.efir.is/mcp
# SUPABASE_MCP_AUTH_HEADER=Basic ...
# SUPABASE_INITIAL_USER=hi@busyproxy.net
# SUPABASE_INITIAL_USER_PASSWORD=
# SUPABASE_SMTP_HOST=smtp.mailgun.org
# SUPABASE_SMTP_PORT=587
# SUPABASE_SMTP_USER=postmaster@mail.busyproxy.net
# SUPABASE_SMTP_PASS=

# Optional Postgres for auth/migrations (PGlite if unset)
# DATABASE_URL=

# Twilio
TWILIO_ACCOUNT_SID=AC...
# Alias: TWILIO_ACCOUNT_ID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MG...
# Alias: TWILIO_SERVICE_ID=
TWILIO_FROM_NUMBER=+1...
TWILIO_TEST_NUMBER_TO_SEND=+373...

# Mailgun (optional)
# MAILGUN_API_KEY=

# Edge gateway hostnames
EDGE_GATE_HOST=gate.busyproxy.net
EDGE_AGENT_HOST=agent.busyproxy.net
EDGE_B2B_ALIAS=proxy.busymate.net
EDGE_HTTP_PORT=18080
EDGE_SOCKS_PORT=11080

RELAY_DEMO_PHONE=+37360123456
RELAY_DEMO_NAME=Alex M.
